class Toko
{
    private List<Produk> daftarProduk = new List<Produk>();

    public void TambahProduk(Produk produk)
    {
        daftarProduk.Add(produk);
        Console.WriteLine($"Produk '{produk.nama}' berhasil ditambahkan ke toko.");
    }

    public void DaftarProduk()
    {
        Console.WriteLine("\n========================================");
        Console.WriteLine("         DAFTAR PRODUK TOKO             ");
        Console.WriteLine("========================================");

        if (daftarProduk.Count == 0)
        {
            Console.WriteLine("Toko masih kosong.");
            return;
        }

        int no = 1;
        foreach (Produk p in daftarProduk)
        {
            Console.WriteLine($"\n[Produk #{no}]");
            p.InfoProduk();
            p.Kategori();
            no++;
        }

        Console.WriteLine("\n========================================");
    }
}

class Program
{
    static void Main(string[] args)
    {
        Console.WriteLine("===== SISTEM PRODUK TOKO =====\n");

        Toko toko = new Toko();

        Laptop laptop = new Laptop("ASUS VivoBook", 8500000, 24);
        HP hp = new HP("Samsung Galaxy A55", 4200000, 12);
        Snack snack = new Snack("Chitato BBQ", 15000, new DateTime(2025, 12, 31));
        Minuman minuman = new Minuman("Teh Botol Sosro", 5000, new DateTime(2026, 6, 30));

        Console.WriteLine("--- Menambah Produk ---");
        toko.TambahProduk(laptop);
        toko.TambahProduk(hp);
        toko.TambahProduk(snack);
        toko.TambahProduk(minuman);

        toko.DaftarProduk();

        Console.WriteLine("\n===== SOAL 1: Kategori() =====");
        laptop.Kategori();
        snack.Kategori();

        Console.WriteLine("\n===== SOAL 2: InstallSoftware() =====");
        laptop.InstallSoftware();

        Console.WriteLine("\n===== SOAL 3: Info Lengkap Laptop =====");
        laptop.InfoProduk();

        Console.WriteLine("\n===== Method Khusus: Telepon() dan Makan() =====");
        hp.Telepon();
        snack.Makan();

        Console.WriteLine("\n===== SOAL 4: Dinginkan() =====");
        minuman.Dinginkan();

        Console.WriteLine("\n===== SOAL 5: Polymorphism dengan variabel Produk =====");
        Produk produkBaru = hp;
        produkBaru.Kategori();


        Console.WriteLine("\n===== Selesai =====");
    }
}
