
class Produk
{
    public string nama { get; set; }
    public double harga { get; set; }

    public Produk(string nama, double harga)
    {
        this.nama = nama;
        this.harga = harga;
    }

    public virtual void InfoProduk()
    {
        Console.WriteLine($"Nama Produk : {nama}");
        Console.WriteLine($"Harga       : Rp {harga:N0}");
    }

    public virtual void Kategori()
    {
        Console.WriteLine($"Kategori    : Produk Umum");
    }
}

class Elektronik : Produk
{
    public int garansi { get; set; }

    public Elektronik(string nama, double harga, int garansi)
        : base(nama, harga)
    {
        this.garansi = garansi;
    }

    public void CekGaransi()
    {
        Console.WriteLine($"Garansi     : {garansi} bulan");
    }

    public override void Kategori()
    {
        Console.WriteLine($"Kategori    : Elektronik");
    }

    public override void InfoProduk()
    {
        base.InfoProduk();
        CekGaransi();
    }
}

class Makanan : Produk
{
    public DateTime tanggalKadaluarsa { get; set; }

    public Makanan(string nama, double harga, DateTime tanggalKadaluarsa)
        : base(nama, harga)
    {
        this.tanggalKadaluarsa = tanggalKadaluarsa;
    }

    public void CekKadaluarsa()
    {
        if (DateTime.Now > tanggalKadaluarsa)
        {
            Console.WriteLine($"Status      : KADALUARSA (expired {tanggalKadaluarsa:dd-MM-yyyy})");
        }
        else
        {
            Console.WriteLine($"Kadaluarsa  : {tanggalKadaluarsa:dd-MM-yyyy} (masih aman)");
        }
    }

    public override void Kategori()
    {
        Console.WriteLine($"Kategori    : Makanan");
    }

    public override void InfoProduk()
    {
        base.InfoProduk();
        CekKadaluarsa();
    }
}

class Laptop : Elektronik
{

    public Laptop(string nama, double harga, int garansi)
        : base(nama, harga, garansi)
    {
    }

    public void InstallSoftware()
    {
        Console.WriteLine($"Menginstall software pada Laptop {nama}...");
        Console.WriteLine("Software berhasil diinstall!");
    }
    public override void Kategori()
    {
        Console.WriteLine($"Kategori    : Elektronik > Laptop");
    }
}

class HP : Elektronik
{
    public HP(string nama, double harga, int garansi)
